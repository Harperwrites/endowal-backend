# One dedicated API deployment and database per client.
CLIENT_ID=endowal
LICENSEE_ID=endowal
LICENSE_ID=development
# Optional link to a sublicensor's license. This is bookkeeping, not entitlement enforcement.
# PARENT_LICENSE_ID=partner-license-001
DEPLOYMENT_ENVIRONMENT=development
DATABASE_URL=sqlite:///./endowal.db
# Production: set a unique, randomly generated secret of at least 32 characters.
SECRET_KEY=change-me
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000"]
ALLOW_SELF_REGISTRATION=true
CREDIT_ENABLED=true
MESSAGING_ENABLED=true
INTEREST_ENABLED=true
